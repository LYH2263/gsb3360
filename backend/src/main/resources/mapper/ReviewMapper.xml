<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.campustrade.mapper.ReviewMapper">

    <resultMap id="ReviewResultMap" type="com.example.campustrade.entity.Review">
        <id property="id" column="id"/>
        <result property="itemId" column="item_id"/>
        <result property="buyerId" column="buyer_id"/>
        <result property="rating" column="rating"/>
        <result property="content" column="content"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <resultMap id="ReviewDTOResultMap" type="com.example.campustrade.dto.ReviewDTO">
        <id property="id" column="id"/>
        <result property="itemId" column="item_id"/>
        <result property="buyerId" column="buyer_id"/>
        <result property="buyerUsername" column="buyer_username"/>
        <result property="rating" column="rating"/>
        <result property="content" column="content"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.example.campustrade.entity.Review" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO reviews (item_id, buyer_id, rating, content, created_at)
        VALUES (#{itemId}, #{buyerId}, #{rating}, #{content}, #{createdAt})
    </insert>

    <select id="findByItemIdAndBuyerId" resultMap="ReviewResultMap">
        SELECT id, item_id, buyer_id, rating, content, created_at
        FROM reviews
        WHERE item_id = #{itemId} AND buyer_id = #{buyerId}
        LIMIT 1
    </select>

    <select id="findByItemId" resultMap="ReviewDTOResultMap">
        SELECT r.id, r.item_id, r.buyer_id, u.username AS buyer_username, r.rating, r.content, r.created_at
        FROM reviews r
        LEFT JOIN users u ON r.buyer_id = u.id
        WHERE r.item_id = #{itemId}
        ORDER BY r.created_at DESC
    </select>

    <select id="findAverageRatingByItemId" resultType="double">
        SELECT AVG(rating)
        FROM reviews
        WHERE item_id = #{itemId}
    </select>

    <select id="countByItemId" resultType="long">
        SELECT COUNT(*)
        FROM reviews
        WHERE item_id = #{itemId}
    </select>

    <select id="findByBuyerId" resultMap="ReviewResultMap">
        SELECT id, item_id, buyer_id, rating, content, created_at
        FROM reviews
        WHERE buyer_id = #{buyerId}
    </select>

</mapper>
